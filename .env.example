# Supabase — testovacia DB pre DEED
# Skopíruj tento súbor na .env.local a doplň hodnoty.
# Nájdeš ich v Supabase: Project Settings → API (alebo ich doplní Claude po výbere projektu).
# .env.local je negitované (*.local v .gitignore).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Test-fáza vypínač: 1 = appka beží 100 % na mock dátach (žiadne volania na
# Supabase → žiadne CORS/sieťové chyby, keď je backend uspatý/nedostupný).
# Prázdne / 0 = normálny režim (živá DB, ak je nakonfigurovaná vyššie).
VITE_USE_MOCK=0
