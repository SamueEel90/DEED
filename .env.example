# DEED — lokálne prostredie
# Skopíruj tento súbor na .env.local a doplň hodnoty (.env.local je negitovaný).

# ---------------------------------------------------------------
# PRVÉ SPUSTENIE BEZ SUPABASE
# Nechaj URL a kľúč prázdne a nastav VITE_USE_MOCK=1 — appka beží
# 100 % na mock dátach zo src/features/*/mock.ts. Žiadna sieť,
# žiadne CORS chyby. Takto sa dá vyvíjať celé UI.
# ---------------------------------------------------------------
VITE_USE_MOCK=1

# ---------------------------------------------------------------
# ŽIVÁ DB (voliteľné)
# Hodnoty: Supabase → Project Settings → API.
# Aby sa reálne použili, musí byť VITE_USE_MOCK=0 (alebo riadok zmazaný)
# a treba reštartovať dev server.
# ---------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Verejná adresa appky pre zdieľané odkazy (Iskry /i/{id}), napr. https://deed.sk.
# Prázdne = adresa, na ktorej appka práve beží (Vercel preview / localhost).
VITE_VEREJNA_URL=

# ---------------------------------------------------------------
# Serverless funkcie v api/ (AI hodnotenie skutkov) majú vlastné
# premenné — ANTHROPIC_API_KEY, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# SCORING_ADMIN_TOKEN. Nastavujú sa vo Verceli, nie tu.
# Zoznam a postup: docs/AI_SKORE_SETUP.md
# Bez ANTHROPIC_API_KEY beží /api/score v mock režime.
# ---------------------------------------------------------------
