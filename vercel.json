{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/i/:id", "destination": "/api/iskra?id=:id" },
    { "source": "/odznak/:id", "destination": "/api/odznak?id=:id" },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.ts": { "maxDuration": 60 }
  }
}
