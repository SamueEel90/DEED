{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/i/:id", "destination": "/api/iskra?id=:id" },
    { "source": "/odznak/:id", "destination": "/api/odznak?id=:id" },
    { "source": "/svetlo/:cesta*", "destination": "/svetlo/index.html" },
    { "source": "/((?!assets/|api/|svetlo/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.ts": { "maxDuration": 60 }
  }
}
